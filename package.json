{
  "name": "humanette-workspace",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "version": "1.0.0",
  "description": "Humanette helps make browser automation videos easier to understand. Add it to your project and you'll get Screen Studio style large cursors and keyboard presses that look like a user using your product.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "check": "turbo typecheck test build",
    "test:e2e": "bun run --cwd apps/web test:e2e",
    "pack:check": "bun run --cwd packages/humanette build && node scripts/pack-check.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/decodetool/humanette.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "humanette": "workspace:*",
    "playwright-core": "^1.58.0",
    "prettier": "^3.6.0",
    "turbo": "^2.8.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/decodetool/humanette/issues"
  },
  "homepage": "https://github.com/decodetool/humanette#readme"
}
